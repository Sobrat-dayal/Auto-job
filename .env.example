# AUTONOM — Sample Environment Configuration
# Copy to .env for local overrides (never commit real credentials)

# Application & Network
AUTONOM_APP_NAME="AUTONOM Agent Backend"
AUTONOM_DEBUG=false
AUTONOM_HOST=127.0.0.1
AUTONOM_PORT=8765

# Storage & Persistence
AUTONOM_DATABASE_FILENAME="autonom.db"
# AUTONOM_DATA_DIR="C:/Users/username/AppData/Local/Autonom/Data"

# Model Providers (Optional: Can also be configured via Settings UI & Windows DPAPI)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# OLLAMA_HOST="http://127.0.0.1:11434"

# Job Search & Platform Defaults
AUTONOM_MAX_APPLICATIONS_PER_DAY=25
AUTONOM_DEFAULT_MATCH_THRESHOLD=75.0
AUTONOM_ALLOW_HEADLESS_BROWSER=true

# Security & Governance
AUTONOM_REQUIRE_APPROVAL_FOR_SUBMISSIONS=true
AUTONOM_EMERGENCY_HOTKEY="Ctrl+Shift+Esc"
